# ============================================
# WhatsApp Service (Phase 3)
# ============================================

# طريقة الربط: "qr" أو "pairing"
WHATSAPP_LINK_METHOD=qr

# مطلوب فقط إذا WHATSAPP_LINK_METHOD=pairing
# صيغة دولية بدون + وبدون مسافات أو شرطات
# مثال لرقم سوري 09xxxxxxxx -> 963xxxxxxxxx
WHATSAPP_PHONE_NUMBER=

# مجلد حفظ الجلسة - لا يُرفع على GitHub أبدًا (محمي بـ .gitignore)
WHATSAPP_AUTH_DIR=./auth_info_baileys

# ============================================
# Phase 4: ربط WhatsApp بـ Gemini API
# ============================================
# رابط API الخاص فينا (نفس مشروع gemini-wa بايثون، شغّله على نفس الجهاز أو سيرفر تاني)
GEMINI_API_URL=http://127.0.0.1:8000

# ⚠️ لازم تكون بنفس قيمة API_KEY الموجودة بملف .env تبع مشروع gemini-wa بايثون بالضبط
GEMINI_API_INTERNAL_KEY=

# تأخير عشوائي قبل الرد (ميلي ثانية) - جزء من تصميم تقليل خطر الرصد الآلي
REPLY_MIN_DELAY_MS=1200
REPLY_MAX_DELAY_MS=3500

# ============================================
# Phase 5: تجميع الرسائل المتتالية (Debounce)
# ============================================
# فترة الهدوء (ميلي ثانية) قبل ما نجمع كل الرسائل المتتالية بطلب واحد لـ Gemini
DEBOUNCE_MS=2000

# ============================================
# Phase 6: فلترة المجموعات المتقدمة
# ============================================
# تفعيل الرد على المجموعات؟ افتراضيًا false (خاص فقط بالكامل)
GROUPS_ENABLED=false

# قائمة الـ JIDs المسموحة، مفصولة بفواصل بدون مسافات.
# فاضي = كل المجموعات مسموحة (طالما GROUPS_ENABLED=true) لكن يبقى شرط
# mention/prefix ساري - البوت ما بيرد على كل رسالة عادية بالمجموعة.
# مثال: ALLOWED_GROUP_JIDS=123456789-987654321@g.us,111222333-444555666@g.us
ALLOWED_GROUP_JIDS=

# طريقة "تفعيل" البوت داخل المجموعة المسموحة:
#   mention -> لازم يُذكر البوت بـ @اسم_البوت
#   prefix  -> لازم تبدأ الرسالة بالبادئة (GROUP_COMMAND_PREFIX)
#   both    -> يكفي أي واحدة من الاتنين
GROUP_TRIGGER_MODE=mention

# البادئة المستخدمة عند GROUP_TRIGGER_MODE=prefix أو both
GROUP_COMMAND_PREFIX=!ai

# ============================================
# Phase 9: ذاكرة المحادثة
# ============================================
# أقصى عدد رسائل (مستخدم + بوت) تُحفظ لكل محادثة - الأقدم يُحذف تلقائيًا
MEMORY_MAX_MESSAGES=20

# ============================================
# Phase 10: قاعدة المعرفة (Knowledge Base)
# ============================================
# مسار ملف تخزين قاعدة المعرفة (يُنشأ تلقائيًا لو مش موجود)
KNOWLEDGE_BASE_FILE=./data/knowledge.json

# أقصى عدد مدخلات من قاعدة المعرفة تُرفق كسياق بكل طلب لـ Gemini
KNOWLEDGE_BASE_MAX_RESULTS=3

# ============================================
# Phase 11: Admin Commands
# ============================================
# JID رقمك (أو أرقام إضافية، مفصولة بفواصل) - فقط هاي الأرقام تقدر تستخدم
# الأوامر الإدارية (/train, /status, !test-*, !kb-*...).
#
# كيف تعرف الـ JID تبعك بالضبط:
#   1. شغّل البوت (npm start)
#   2. من رقم تاني، أرسل أي رسالة خاصة للبوت من رقمك الشخصي (رقمك الحقيقي،
#      مو رقم البوت)
#   3. راقب الـ terminal - رح تشوف سطر "📩 من [JID]: ..." أو مشابه
#   4. انسخ الـ JID بالضبط (مثال: "9639xxxxxxxxx@s.whatsapp.net" أو
#      صيغة أحدث زي "151960707674240@lid") وحطه هون
ADMIN_JIDS=
