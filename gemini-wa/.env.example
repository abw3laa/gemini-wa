# ============================================
# Gemini API (Phase 1)
# ============================================
# احصل على مفتاحك من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اتركه كما هو ما لم يكن لديك سبب لتغييره.
# Flash موصى به: حدود مجانية أعلى بكثير من Pro، وكافٍ تمامًا لبوت شخصي.
GEMINI_MODEL=gemini-3.6-flash

GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7
GEMINI_TIMEOUT_SECONDS=30

# ============================================
# API الخاص فينا (Phase 2)
# ============================================
# مفتاح داخلي من اختراعك - مختلف تمامًا عن GEMINI_API_KEY.
# أي Client (WhatsApp لاحقًا) لازم يرسله بترويسة X-API-Key.
# ولّده مثلاً بأمر: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# الحد الفعلي المسموح من Gemini بالدقيقة على حسابك (راجع aistudio.google.com > Rate Limits)
# 5 هو الافتراضي المشاهد فعليًا على gemini-3.6-flash بالـ free tier وقت كتابة هذا الملف
GEMINI_RPM_LIMIT=5

# أقصى وقت (بالثواني) ينتظره طلب بالطابور قبل ما نرجع خطأ "busy" للمستخدم
RATE_LIMIT_MAX_WAIT_SECONDS=45

# رابط الـ API عند اختباره محليًا (يُستخدم فقط من test_api.py)
API_URL=http://127.0.0.1:8000

# ============================================
# ستُضاف لاحقًا في المراحل القادمة:
# ============================================
# WHATSAPP_...           (Phase 3)
